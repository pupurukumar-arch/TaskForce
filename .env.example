NODE_ENV=development
PORT=3000

MONGO_URI=mongodb+srv://USERNAME:PASSWORD@HOST/taskforce_dev?retryWrites=true&w=majority
TEST_MONGO_URI=mongodb+srv://USERNAME:PASSWORD@HOST/taskforce_test?retryWrites=true&w=majority

ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret
REFRESH_TOKEN_EXPIRY=10d

CORS_ORIGIN=http://localhost:5173
# Optional locally; required in Vercel production to share auth limits across functions.
REDIS_URL=rediss://USERNAME:PASSWORD@HOST:PORT
# Server-only Gemini key for Project Pulse. Do not expose this in the frontend.
GEMINI_API_KEY=your_key_here
FORGOT_PASSWORD_REDIRECT_URL=http://localhost:5173/reset-password
PROJECT_INVITE_REDIRECT_URL=http://localhost:5173/register

# Production transactional SMTP credentials. For Mailtrap Email Sending,
# use the credentials under Sending Domains > Integration, not Email Sandbox.
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=replace-with-production-smtp-user
SMTP_PASS=replace-with-production-smtp-password
SMTP_FROM=Task Force Orbit <no-reply@your-verified-domain.example>
EMAIL_MAX_RETRIES=2
EMAIL_RETRY_DELAY_MS=750

AWS_REGION=replace-with-existing-bucket-region
AWS_S3_BUCKET=replace-with-existing-private-bucket-name
AWS_ACCESS_KEY_ID=replace-with-minimum-permission-access-key
AWS_SECRET_ACCESS_KEY=replace-with-secret-access-key

NODE_ENV=development
PORT=3000

MONGO_URI=mongodb+srv://USERNAME:PASSWORD@HOST/taskforce_dev?retryWrites=true&w=majority
TEST_MONGO_URI=mongodb+srv://USERNAME:PASSWORD@HOST/taskforce_test?retryWrites=true&w=majority

ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret
REFRESH_TOKEN_EXPIRY=10d

CORS_ORIGIN=http://localhost:5173
FORGOT_PASSWORD_REDIRECT_URL=http://localhost:5173/reset-password
PROJECT_INVITE_REDIRECT_URL=http://localhost:5173/register

MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USER=replace-with-smtp-user
MAILTRAP_SMTP_PASS=replace-with-smtp-password

AWS_REGION=replace-with-existing-bucket-region
AWS_S3_BUCKET=replace-with-existing-private-bucket-name
AWS_ACCESS_KEY_ID=replace-with-minimum-permission-access-key
AWS_SECRET_ACCESS_KEY=replace-with-secret-access-key

PORT=3000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/taskforge
# Use a separate database for automated tests. Never use your main database here.
TEST_MONGO_URI=mongodb://127.0.0.1:27017/taskforge_test
ACCESS_TOKEN_SECRET=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=replace_with_a_different_long_random_secret
REFRESH_TOKEN_EXPIRY=10d
CORS_ORIGIN=http://localhost:5173
FORGOT_PASSWORD_REDIRECT_URL=http://localhost:5173/reset-password

{
  "name": "taskforge-api",
  "version": "1.0.0",
  "description": "Role-based project collaboration and task review API",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "test": "NODE_ENV=test node --test --test-concurrency=1 test/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm test && npm --prefix frontend run lint && npm --prefix frontend test && npm --prefix frontend run build && npm run test:e2e",
    "docker:build": "docker build -t taskforce-api:local .",
    "docker:up": "docker compose up --build"
  },
  "keywords": [
    "project-management",
    "collaboration",
    "express",
    "mongodb",
    "react"
  ],
  "author": "Puru Kumar",
  "license": "ISC",
  "engines": {
    "node": ">=20.19.0 <26"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "nodemon": "^3.1.10",
    "prettier": "3.6.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1102.0",
    "@aws-sdk/s3-request-presigner": "^3.1102.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.0",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "mailgen": "^2.0.29",
    "mammoth": "^1.12.0",
    "mongoose": "^8.16.5",
    "multer": "^2.0.2",
    "nodemailer": "9.0.4",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.2.0",
    "swagger-ui-express": "^5.0.1"
  }
}
